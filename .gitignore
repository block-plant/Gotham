# ──────────────────────────────────────────────
# Graph tensors — binary / LMDB files
# These are generated by the pipeline and can be hundreds of GB.
# Regenerate with the full pipeline (see HOW_TO_RUN.md).
# Exception: graph_meta.json is tiny and useful to keep.
# ──────────────────────────────────────────────
**/graph_tensors/edge_src.bin
**/graph_tensors/edge_dst.bin
**/graph_tensors/node_features.bin
**/graph_tensors/link_labels.pt
**/graph_tensors/node_embeddings.index
**/graph_tensors/node_mapping.lmdb/
**/graph_tensors/reverse_mapping.lmdb/
# Keep graph_meta.json — it's just 50 bytes and documents the graph shape
!**/graph_tensors/graph_meta.json

# Trained model checkpoint — large binary, train on your own machine
**/graph_tensors/link_predictor.pt

# Binary caches — generated automatically on first boot
**/graph_tensors/fir_data_cache.pkl
**/graph_tensors/mapping_cache.pkl

# ──────────────────────────────────────────────
